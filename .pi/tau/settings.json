{
  "$schema": "https://raw.githubusercontent.com/shanepadgett/tau-agent/refs/heads/main/packages/agent/schemas/tau.schema.json",
  "extensions": {
    "context": {
      "sync": {
        "enabled": false
      }
    },
    "subagent": {
      "disabled": ["scout"]
    },
    "toolApproval": {
      "enabled": false
    },
    "silentCommandRunner": {
      "commands": [
        {
          "name": "Lint Markdown",
          "details": "Lint markdown with fixes. Reports only remaining errors.",
          "command": "mise run lint:markdown",
          "includeGlobs": ["**/*.md"]
        },
        {
          "name": "Lint Oxlint",
          "details": "Apply safe fixes. Report remaining lint errors before formatting.",
          "command": "mise run lint:oxlint",
          "includeGlobs": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.mts",
            "**/*.cts",
            "**/*.js",
            "**/*.jsx",
            "**/*.mjs",
            "**/*.cjs",
            "**/.oxlintrc.json",
            "**/oxlint.config.*",
            "mise.toml"
          ]
        },
        {
          "name": "Format Oxfmt",
          "details": "Format files after lint fixes.",
          "command": "mise run lint:oxfmt",
          "includeGlobs": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.mts",
            "**/*.cts",
            "**/*.js",
            "**/*.jsx",
            "**/*.mjs",
            "**/*.cjs",
            "**/*.json",
            "**/*.jsonc",
            "**/*.json5",
            "**/*.css",
            "**/*.scss",
            "**/*.less",
            "**/*.html",
            "**/*.md",
            "**/*.mdx",
            "**/*.yml",
            "**/*.yaml",
            "**/*.toml"
          ]
        },
        {
          "name": "Dead code",
          "details": "Check design/ for unused code after fixes and formatting. Reports findings without deleting code.",
          "command": "mise run lint:fallow",
          "includeGlobs": ["design/**", "mise.toml"],
          "excludeGlobs": ["design/vibe-lab.html"]
        }
      ]
    }
  }
}
