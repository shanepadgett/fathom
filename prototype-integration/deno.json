{
  "tasks": {
    "dev": "deno task build:ui && deno run -A --watch main.ts",
    "desktop": "deno task build:ui && deno run -A scripts/prepare-native.ts && deno desktop -A --backend cef --include ui --include native --include migrations --include examples/mcp-server.ts --output dist/Fathom main.ts",
    "integration": "deno task build:ui && deno run -A scripts/integration-smoke.ts",
    "migrations": "deno run -A npm:drizzle-kit@1.0.0-rc.4 generate",
    "start": "deno task build:ui && deno run -A main.ts",
    "verify": "deno check main.ts scripts/integration-smoke.ts scripts/native-smoke.ts && deno task integration",
    "smoke": "deno run -A scripts/smoke.ts",
    "build:ui": "deno run -A npm:vite@8.2.2 build",
    "watch:ui": "deno run -A npm:vite@8.2.2 build --watch"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.85.1",
    "typebox": "npm:typebox@1.3.27",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.4",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@2.0.0",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.0.0",
    "vscode-jsonrpc": "npm:vscode-jsonrpc@9.0.2",
    "@sigma/pty-ffi": "jsr:@sigma/pty-ffi@0.42.0",
    "monaco-editor": "npm:monaco-editor@0.56.0",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.11.0",
    "markdown-it": "npm:markdown-it@15.0.1",
    "shiki": "npm:shiki@4.4.3",
    "cordis": "npm:cordis@4.0.0-rc.9",
    "proper-lockfile": "npm:proper-lockfile@4.1.2",
    "@types/proper-lockfile": "npm:@types/proper-lockfile@4.1.4",
    "vite": "npm:vite@8.2.2",
    "solid-js": "npm:solid-js@1.9.15",
    "vite-plugin-solid": "npm:vite-plugin-solid@2.11.14"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "strict": true
  },
  "desktop": {
    "app": {
      "name": "Fathom Integration Prototype",
      "identifier": "dev.fathom.prototype.integration"
    },
    "backend": "cef"
  },
  "exclude": [
    "dist",
    ".fathom",
    "node_modules",
    "ui"
  ],
  "nodeModulesDir": "auto"
}
