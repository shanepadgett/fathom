{
  "tasks": {
    "check": "deno fmt --check && deno lint src demo.ts demo_auth.ts && deno check --unstable-net src/mod.ts demo.ts demo_auth.ts",
    "demo": "deno run --unstable-net --allow-env=HOME,XAI_API_KEY --allow-read=$HOME/.pi/agent/auth.json --allow-net=chatgpt.com,api.anthropic.com,api.x.ai demo.ts",
    "demo:all": "deno run --unstable-net --allow-env=HOME,XAI_API_KEY --allow-read=$HOME/.pi/agent/auth.json --allow-net=chatgpt.com,api.anthropic.com,api.x.ai demo.ts all"
  },
  "fmt": {
    "lineWidth": 100
  }
}
