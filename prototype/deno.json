{
  "tasks": {
    "dev": "deno run -A --watch main.ts",
    "desktop": "deno desktop -A --backend cef --include ui --output dist/Fathom main.ts",
    "start": "deno run -A main.ts",
    "verify": "deno run -A scripts/verify.ts",
    "smoke": "deno run -A scripts/smoke.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.85.0",
    "cordis": "npm:cordis@4.0.0-rc.9",
    "proper-lockfile": "npm:proper-lockfile@4.1.2",
    "@types/proper-lockfile": "npm:@types/proper-lockfile@4.1.4"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "desktop": {
    "app": {
      "name": "Fathom Prototype",
      "identifier": "dev.fathom.prototype"
    },
    "backend": "cef"
  },
  "exclude": ["dist", ".fathom", "node_modules"]
}
