{
  "tasks": {
    "start": "deno run -A main.ts",
    "dev": "FATHOM_BASELINE_DEV=1 deno run -A --watch main.ts",
    "check": "deno check main.ts ui/main.tsx"
  },
  "imports": {
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.85.1",
    "typebox": "npm:typebox@1.3.27",
    "cordis": "npm:cordis@4.0.0-rc.9",
    "@std/path": "jsr:@std/path@1.1.2",
    "vite": "npm:vite@8.2.2",
    "solid-js": "npm:solid-js@1.9.15",
    "vite-plugin-solid": "npm:vite-plugin-solid@2.11.14",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@phosphor-icons/web": "npm:@phosphor-icons/web@2.1.2"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
  },
  "desktop": {
    "app": {
      "name": "Fathom Baseline",
      "identifier": "dev.fathom.baseline"
    },
    "backend": "cef"
  },
  "exclude": ["dist", "public", "node_modules"],
  "nodeModulesDir": "auto"
}
