{
  "tasks": {
    "dev": "deno task build:ui && deno run -A --watch main.ts",
    "desktop": "deno task build:ui && deno desktop -A --backend cef --include ui --output dist/Fathom main.ts",
    "start": "deno task build:ui && deno run -A main.ts",
    "verify": "deno task build:ui && deno run -A scripts/verify.ts",
    "smoke": "deno run -A scripts/smoke.ts",
    "build:ui": "deno run -A npm:vite@8.2.2 build",
    "watch:ui": "deno run -A npm:vite@8.2.2 build --watch"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.85.0",
    "cordis": "npm:cordis@4.0.0-rc.9",
    "proper-lockfile": "npm:proper-lockfile@4.1.2",
    "@types/proper-lockfile": "npm:@types/proper-lockfile@4.1.4",
    "vite": "npm:vite@8.2.2",
    "solid-js": "npm:solid-js@1.9.15",
    "vite-plugin-solid": "npm:vite-plugin-solid@2.11.14"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "desktop": {
    "app": {
      "name": "Fathom Solid Prototype",
      "identifier": "dev.fathom.prototype.solid"
    },
    "backend": "cef"
  },
  "exclude": ["dist", ".fathom", "node_modules", "ui"],
  "nodeModulesDir": "auto"
}
