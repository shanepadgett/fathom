{
  "nodeModulesDir": "auto",
  "imports": {
    "lit": "npm:lit@3.3.1",
    "lit/directives/style-map.js": "npm:lit@3.3.1/directives/style-map.js",
    "@phosphor-icons/web": "npm:@phosphor-icons/web@2.1.2",
    "vite": "npm:vite@8.2.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "tailwindcss": "npm:tailwindcss@4.3.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "tasks": {
    "dev": "deno run -A npm:vite@8.2.2",
    "build": "deno run -A npm:vite@8.2.2 build",
    "check": "deno check main.ts verification/contracts.ts && deno lint && deno fmt --check && deno test --allow-read verification",
    "fmt": "deno fmt"
  },
  "fmt": { "exclude": ["dist", "node_modules", "vibe-lab.html"] },
  "lint": { "exclude": ["dist", "node_modules"] }
}
