{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/markdown.py\"",
            "timeout": 60,
            "statusMessage": "Formatting Markdown"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/design.py\"",
            "timeout": 180,
            "statusMessage": "Checking and building design reference"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/app.py\"",
            "timeout": 300,
            "statusMessage": "Checking and building Fathom"
          }
        ]
      }
    ]
  }
}
